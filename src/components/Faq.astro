---
import CallButton from './CallButton.astro';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { faqs, faqSection as s, business, cta } from '../data/site';

const groups = [...new Set(faqs.map((f) => f.group))];
---

<section class="bg-primary-soft py-16 md:py-24" aria-labelledby="faq-heading">
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <SectionHeading id="faq-heading" eyebrow={s.eyebrow} title={s.title} intro={s.intro} />

    {groups.map((group, gi) => (
      <div class="mt-10" data-reveal>
        <h3 class="text-lg font-bold">{group}</h3>
        <div class="mt-3 divide-y divide-border rounded-2xl border border-border bg-white">
          {faqs.filter((f) => f.group === group).map((f, i) => (
            <details class="group" open={gi === 0 && i === 0}>
              <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-semibold hover:text-primary">
                {f.question}
                <Icon name="chevron-down" size={20} class="chevron shrink-0 text-primary" />
              </summary>
              <p class="px-5 pb-5 text-muted">{f.answer}</p>
            </details>
          ))}
        </div>
      </div>
    ))}

    <div data-reveal class="mt-12 flex flex-col items-center gap-4 rounded-2xl border border-border bg-white p-6 text-center sm:p-8">
      <p class="font-display text-xl font-bold text-primary sm:text-2xl">{s.ctaText}</p>
      <CallButton label={cta.ask} sublabel={business.phoneDisplay} fullWidthMobile />
    </div>
  </div>
</section>
