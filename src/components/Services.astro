---
import CallButton from './CallButton.astro';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import ExtraWorks from './ExtraWorks.astro';
import { services, servicesSection as s, objections, cta } from '../data/site';
---

<section class="py-16 md:py-24" aria-labelledby="services-heading">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <SectionHeading id="services-heading" eyebrow={s.eyebrow} title={s.title} intro={s.intro} />

    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((item) => (
        <li class="lift rounded-xl border border-border bg-white p-6 shadow-card" data-reveal>
          <span class="grid h-12 w-12 place-items-center rounded-xl bg-primary-soft text-primary">
            <Icon name={item.icon} size={24} />
          </span>
          <h3 class="mt-4 text-lg font-bold">{item.title}</h3>
          <p class="mt-1.5 text-muted">{item.text}</p>
        </li>
      ))}
    </ul>

    <ExtraWorks />

    <div data-reveal class="mt-12 flex flex-col items-start gap-4 rounded-2xl bg-primary-soft p-6 sm:p-8 md:flex-row md:items-center md:justify-between">
      <p class="font-display text-xl font-bold text-primary sm:text-2xl">{s.ctaText}</p>
      <CallButton label={cta.short} fullWidthMobile reassurance={objections.services} />
    </div>
  </div>
</section>
