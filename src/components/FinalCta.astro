---
import CallButton from './CallButton.astro';
import Icon from './Icon.astro';
import { business, objections, finalCta, cta } from '../data/site';
---

<section class="on-dark relative overflow-hidden bg-primary py-16 text-center text-white md:py-24" aria-labelledby="final-heading">
  <div class="pointer-events-none absolute -top-24 left-1/2 h-72 w-[40rem] -translate-x-1/2 rounded-full bg-white/10 blur-3xl" aria-hidden="true"></div>
  <div data-reveal class="relative mx-auto flex max-w-3xl flex-col items-center px-4 sm:px-6">
    <h2 id="final-heading" class="text-3xl leading-tight font-extrabold text-white sm:text-5xl">{finalCta.title}</h2>
    <a
      href={business.phoneTel}
      aria-label={business.callLabel}
      class="tabular mt-6 font-display text-4xl font-extrabold tracking-tight text-white underline-offset-8 hover:underline sm:text-6xl"
    >
      {business.phoneDisplay}
    </a>
    <p class="mt-2 flex items-center gap-2 text-blue-100">
      <Icon name="clock" size={18} />
      {finalCta.available}
    </p>
    <CallButton label={cta.primary} size="lg" fullWidthMobile onDark reassurance={objections.final} class="mt-8 items-center" />
  </div>
</section>
