---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { howItWorks as h } from '../data/site';
---

<section class="bg-primary-soft py-16 md:py-24" aria-labelledby="how-heading">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <SectionHeading id="how-heading" eyebrow={h.eyebrow} title={h.title} center />
    <ol class="mt-10 grid gap-6 md:grid-cols-3">
      {h.steps.map((step, i) => (
        <li class="lift relative rounded-xl bg-white p-6 text-center shadow-card" data-reveal>
          <span class="mx-auto grid h-14 w-14 place-items-center rounded-full bg-primary text-white">
            <Icon name={step.icon} size={26} />
          </span>
          <p class="mt-4 text-sm font-bold tracking-wider text-primary/70 uppercase">{h.stepLabel} {i + 1}</p>
          <h3 class="mt-1 text-xl font-bold">{step.title}</h3>
          <p class="mt-1.5 text-muted">{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
