---
import Icon from './Icon.astro';
import { business, footer } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="on-dark bg-navy-900 px-4 pt-12 pb-40 text-center text-blue-100 sm:px-6 md:pb-12">
  <div class="mx-auto flex max-w-3xl flex-col items-center gap-4">
    <p class="font-display text-xl font-extrabold text-white">{business.name}</p>
    <a href={business.phoneTel} aria-label={business.callLabel} class="tabular font-display text-3xl font-bold text-white hover:underline">
      {business.phoneDisplay}
    </a>
    <p class="text-sm">{footer.credentials}</p>
    <p class="text-sm">{footer.serving}</p>
    <a href="#top" class="inline-flex min-h-11 items-center gap-1.5 rounded-md px-3 text-sm font-semibold text-white hover:underline">
      <Icon name="arrow-up" size={16} />
      {footer.backToTop}
    </a>
    <p class="text-xs text-blue-200">© {year} {business.name} · {footer.note}</p>
  </div>
</footer>
