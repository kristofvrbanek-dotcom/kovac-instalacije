---
interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  intro?: string;
  center?: boolean;
  onDark?: boolean;
}

const { id, eyebrow, title, intro, center = false, onDark = false } = Astro.props;
---

<div data-reveal class:list={['max-w-2xl', center && 'mx-auto text-center']}>
  {eyebrow && (
    <p class:list={['text-sm font-bold tracking-wider uppercase', onDark ? 'text-blue-200' : 'text-primary/80']}>{eyebrow}</p>
  )}
  <h2 id={id} class:list={['mt-2 text-3xl leading-tight font-extrabold sm:text-4xl', onDark && 'text-white']}>{title}</h2>
  {intro && <p class:list={['mt-3 text-lg', onDark ? 'text-blue-100' : 'text-muted']}>{intro}</p>}
</div>
