---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { guarantees, guaranteesSection as s } from '../data/site';
---

<section class="bg-navy-900 py-16 text-white md:py-24 on-dark" aria-labelledby="guarantees-heading">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <SectionHeading id="guarantees-heading" eyebrow={s.eyebrow} title={s.title} onDark />
    <ul class="mt-10 grid gap-5 md:grid-cols-3">
      {guarantees.map((g) => (
        <li class="lift flex flex-col rounded-2xl border border-white/10 bg-white/5 p-6 sm:p-7" data-reveal>
          <span class="grid h-12 w-12 place-items-center rounded-xl bg-white text-primary">
            <Icon name={g.icon} size={24} />
          </span>
          <h3 class="mt-5 text-xl leading-snug font-extrabold text-white">{g.title}</h3>
          <p class="mt-3 text-blue-100">{g.text}</p>
          <p class="mt-auto pt-5 text-sm text-blue-200"><strong class="text-white">{s.coversLabel}</strong> {g.covers}</p>
        </li>
      ))}
    </ul>
    <p class="mt-8 max-w-3xl text-sm text-blue-200">{s.note}</p>
  </div>
</section>
