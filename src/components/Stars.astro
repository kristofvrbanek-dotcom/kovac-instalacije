---
// Pet zvezdic, napolnjenih sorazmerno z oceno (npr. 4,2 → 84 %). Okrasno; ocena je izpisana v besedilu ob njih.
import Icon from './Icon.astro';

interface Props {
  value: number;
  size?: number;
}

const { value, size = 16 } = Astro.props;
const percent = Math.max(0, Math.min(100, (value / 5) * 100));
const row = [1, 2, 3, 4, 5];
---

<span class="relative inline-flex shrink-0" aria-hidden="true">
  <span class="flex text-slate-300">
    {row.map(() => <Icon name="star" size={size} fill="currentColor" />)}
  </span>
  <span class="absolute inset-y-0 left-0 flex overflow-hidden text-star" style={`width: ${percent}%`}>
    {row.map(() => <Icon name="star" size={size} fill="currentColor" class="shrink-0" />)}
  </span>
</span>
